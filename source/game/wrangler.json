{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sheep-fortune-game",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sheep-fortune-game-db",
      "database_id": "f9d115b4-6309-4aab-a1a1-79f6fac70d5f",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "LIVE_PAYMENTS_ENABLED": "false",
    "PAYMENT_MODE": "vault",
    "TOKEN_ADDRESS": "0x61bEcda3b07301889b51Fd84b0E58385311590ba",
    "TOKEN_SYMBOL": "TST",
    "BSC_CONFIRMATIONS": "20",
    "TRUST_PLATFORM_IDENTITY": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "account_id": "5b6092c4a7492f32938124703cfd5a0b"
}
