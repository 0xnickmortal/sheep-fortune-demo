{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sheep-fortune-game",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sheep-fortune-game-db",
      "database_id": "f9d115b4-6309-4aab-a1a1-79f6fac70d5f",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "LIVE_PAYMENTS_ENABLED": "true",
    "PAYMENT_MODE": "vault",
    "TOKEN_ADDRESS": "0xaf4d973fceacba24467c01ca8c8dd0e820b18732",
    "TOKEN_SYMBOL": "羊年吉祥",
    "BSC_CONFIRMATIONS": "20",
    "TRUST_PLATFORM_IDENTITY": "false",
    "BSC_RPC_URL": "https://bsc-dataseed.bnbchain.org",
    "POOL_SYNC_ENABLED": "true",
    "VAULT_ADDRESS": "0x8Fd45A2B7582fe5bEc61b7aF959C69714baFA1B5",
    "ADMIN_WALLET": "0x0e6cFe55b8F1AC4e1E0377AD2b7078716aB06f34",
    "DEPOSIT_START_BLOCK": "122584076",
    "POOL_FUND_SYNC_ENABLED": "true",
    "PAYMENT_SYNC_ENABLED": "true",
    "PAYMENTS_VALIDATION_ENABLED": "false",
    "BET_PROTECTION_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "account_id": "5b6092c4a7492f32938124703cfd5a0b",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
