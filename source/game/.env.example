# Real payments remain disabled until the end-to-end BSC checks are complete.
LIVE_PAYMENTS_ENABLED=false
# Public first-five recovery plus persistent zero exclusion for stakes >= 50% of balance.
# Enable explicitly; the overall return is no longer the fixed 77% base value.
BET_PROTECTION_ENABLED=false
PAYMENT_MODE=vault
TOKEN_ADDRESS=0xaf4d973fceacba24467c01ca8c8dd0e820b18732
TOKEN_SYMBOL=羊年吉祥
BSC_RPC_URL=
# Deployed SheepGameVault and server-only issuer key. Never put the key in client files.
VAULT_ADDRESS=
VAULT_SIGNER_PRIVATE_KEY=
# The fields below are only for explicit PAYMENT_MODE=legacy-wallet.
DEPOSIT_ADDRESS=
DEPOSIT_START_BLOCK=
BSC_CONFIRMATIONS=20
# A separate public wallet used only to fund the game treasury.
TREASURY_FUNDING_ADDRESS=
# Server-only secret, at least 32 random characters. Never place in frontend.
OPS_AUTH_KEY=
PORT=4318
# Confirmed direct pool income sync (taxes / unsolicited transfers); no signing or transfers.
POOL_SYNC_ENABLED=false
POOL_FUND_SYNC_ENABLED=false
PAYMENT_SYNC_ENABLED=false
# Public administrator address; signatures are verified by the server.
ADMIN_WALLET=
# Allows ADMIN_WALLET and the pinned, enabled whitelist cohort to deposit/play/withdraw.
# Public access stays closed. Non-admin cohort members must still be enabled in D1.
PAYMENTS_VALIDATION_ENABLED=false
# JSON array of BSC addresses. Configure as a Worker secret; never ship the live list to clients.
PAYMENTS_VALIDATION_WALLETS=[]
